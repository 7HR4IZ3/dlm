{
  "name": "download-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Service-backed Bun download manager with OpenTUI",
  "bin": {
    "dlm": "./src/bin/dlm.ts",
    "dlmd": "./src/bin/dlmd.ts"
  },
  "scripts": {
    "dev": "bun run src/bin/dlmd.ts start --foreground",
    "daemon": "bun run src/bin/dlmd.ts start --foreground",
    "tui": "bun run src/bin/dlm.ts tui",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx tsc --noEmit",
    "build": "bun build ./src/bin/dlm.ts ./src/bin/dlmd.ts --outdir dist --target bun",
    "build:bin": "bun run scripts/build-binaries.ts"
  },
  "dependencies": {
    "@opentui/core": "^0.1.102",
    "@opentui/react": "^0.1.102",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/react": "^19.2.14",
    "typescript": "^6.0.3"
  }
}
